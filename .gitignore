# Cartelle e file specifici del progetto Android Studio
.gradle
/local.properties
/.idea/workspace.xml
/.idea/libraries/
.DS_Store
Thumbs.db
*.tmp
*.swp
*.log
.env*

/build
# Ignore all build/ folders recursively
**/build/
/captures
/out

# Log KSP e di compilazione
/kspCaches/

# File personali e cache
*.iml
*.class
*.jar
# The Gradle Wrapper bootstrap JAR is source-controlled and required for reproducible builds.
!gradle/wrapper/gradle-wrapper.jar

# Files generati dal Debug
# * Se hai un problema con .idea, potresti doverlo aggiungere e rimuovere l'intera cartella
/.idea/

# Additional local IDE and build output folders to ignore
.kotlin/
.run/
/.vscode/

# Android App build outputs (redundant but explicit)
# Already excluded by **/build/, but keep explicit entry
/app/build/
/app/release/

# Local SDK / Credentials files
/local.properties
/key

/.gradle-user-home/
.Cleanup-Now.ps1
.Dump-Repo.ps1
./tools
/.cursor
/.continue
/build
/artifacts

build.gradle.kts
build.gradle.kts
gradle.properties
.codex-wrapper-bootstrap/build.gradle
.codex-wrapper-bootstrap/gradlew
.codex-wrapper-bootstrap/gradlew.bat
